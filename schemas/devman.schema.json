{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devman.dev/schemas/devman.schema.json",
  "title": "DevMan project configuration",
  "description": "Canonical devman.yaml schema (V0.1). Paths are always relative to the project root so the file can be shared across Windows, macOS and Linux.",
  "type": "object",
  "required": ["version", "project", "services"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "description": "Schema version. V0.1 only supports 1."
    },
    "project": { "$ref": "#/$defs/project" },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/service" }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Services started by a bare `devman start`."
        }
      }
    },
    "profiles": {
      "type": "object",
      "description": "Named service sets for `devman start --profile <name>`.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "duration": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h)$" },
        { "type": "integer", "minimum": 1, "description": "Seconds." }
      ]
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "display_name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display_name": { "type": "string" },
        "runtime": {
          "enum": ["host", "docker-compose", "external"],
          "default": "host",
          "description": "host runs a local process, docker-compose delegates to `docker compose`, external is monitor-only."
        },
        "cwd": {
          "type": "string",
          "default": ".",
          "description": "Working directory, relative to the project root."
        },
        "command": {
          "type": "string",
          "description": "Executable name or path. Use platform overlays for OS differences; this field is never a mapping."
        },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Argument vector. Must be empty when shell is enabled."
        },
        "shell": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "enum": ["powershell"] } }
            }
          ],
          "default": false
        },
        "env_file": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Env files relative to cwd, applied in order."
        },
        "env": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/envName" },
          "additionalProperties": { "type": "string" }
        },
        "required_env": {
          "type": "array",
          "items": { "$ref": "#/$defs/envName" },
          "description": "Startup is blocked with ENV_MISSING when any of these is absent."
        },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/port" }
        },
        "depends_on": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            {
              "type": "object",
              "additionalProperties": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": {
                  "condition": { "enum": ["started", "healthy"], "default": "started" }
                }
              }
            }
          ]
        },
        "health": { "$ref": "#/$defs/health" },
        "restart": { "$ref": "#/$defs/restart" },
        "autostart": { "type": "boolean", "default": false },
        "graceful_timeout": { "$ref": "#/$defs/duration" },
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service"],
          "properties": {
            "file": { "type": "string", "default": "docker-compose.yml" },
            "service": { "type": "string" },
            "project": { "type": "string", "description": "Compose project name (`-p`)." }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "windows": { "$ref": "#/$defs/platformOverlay" },
            "macos": { "$ref": "#/$defs/platformOverlay" },
            "linux": { "$ref": "#/$defs/platformOverlay" }
          }
        }
      }
    },
    "platformOverlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "env": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/envName" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "port": {
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "value": {
          "oneOf": [
            { "const": "auto" },
            { "type": "integer", "minimum": 1, "maximum": 65535 }
          ]
        },
        "preferred": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Only valid with value: auto. Used when free, otherwise the next free port in range is chosen."
        },
        "env": { "$ref": "#/$defs/envName" },
        "range": {
          "type": "string",
          "default": "general",
          "description": "Named port range from the global settings."
        }
      }
    },
    "health": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["process", "tcp", "http"] },
        "url": { "type": "string", "description": "Required for type http. Supports ${PORT} / ${PORT:name}." },
        "host": { "type": "string", "default": "127.0.0.1" },
        "port": { "type": "string", "description": "Required for type tcp. Supports ${PORT} / ${PORT:name}." },
        "expected_status": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 599 },
          "default": [200]
        },
        "interval": { "$ref": "#/$defs/duration" },
        "timeout": { "$ref": "#/$defs/duration" },
        "retries": { "type": "integer", "minimum": 0 }
      }
    },
    "restart": {
      "type": "object",
      "required": ["policy"],
      "additionalProperties": false,
      "properties": {
        "policy": { "enum": ["no", "on-failure", "always"], "default": "no" },
        "max_attempts": { "type": "integer", "minimum": 0 },
        "delay": { "$ref": "#/$defs/duration" },
        "max_delay": { "$ref": "#/$defs/duration" }
      }
    }
  }
}
