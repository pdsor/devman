/devman
/devman.exe
*.test
*.exe
*.out

# DevMan local state (never commit)
.devman-home/
*.db
*.db-shm
*.db-wal
auth-token
daemon.json

# Node / Tauri
node_modules/
apps/desktop/dist/
apps/desktop/src-tauri/target/
# Regenerated by the Tauri build from tauri.conf.json and the capabilities.
apps/desktop/src-tauri/gen/
# Built by `go run ./tools/build sidecar` before every desktop build.
apps/desktop/src-tauri/binaries/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
